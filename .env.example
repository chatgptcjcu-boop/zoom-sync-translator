# 服務埠號
PORT=3100

# 翻譯引擎：mymemory | gemini | deepl | openai
# 正式會議建議：gemini 或 deepl 或 openai
TRANSLATE_PROVIDER=gemini

# Google Gemini（推薦：申請簡單，適合本專案）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepL（日⇄中也很穩）
# https://www.deepl.com/pro-api
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 翻譯失敗重試次數
TRANSLATE_RETRIES=2

# 允許的 CORS 來源（逗號分隔；* 表示全部，正式環境請改為你的網域）
CORS_ORIGIN=*

# 信任的反向代理層數（部署在 Railway / Render / Nginx 時設 1）
TRUST_PROXY=0
