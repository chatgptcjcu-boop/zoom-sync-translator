# 服務埠號
PORT=3100

# 翻譯引擎（正式預設：gemini）
# 可選：gemini | deepl | openai | mymemory
TRANSLATE_PROVIDER=gemini

# Google Gemini（正式會議首選）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepL（選用；僅當 TRANSLATE_PROVIDER=deepl 時為主引擎）
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# OpenAI（選用；僅當 TRANSLATE_PROVIDER=openai 時為主引擎）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TRANSLATE_RETRIES=2
CORS_ORIGIN=*
TRUST_PROXY=0

# Required: generate distinct values with `openssl rand -base64 48`.
# The host opens /r/<HOST_LOBBY_TOKEN>; never publish this URL.
HOST_LOBBY_TOKEN=
# Signs time-limited guest invitations. It must be distinct from HOST_LOBBY_TOKEN.
INVITE_SECRET=
# Per room, protects the server-side translation quota. Default: 24/minute.
MAX_TRANSLATIONS_PER_MINUTE=24
