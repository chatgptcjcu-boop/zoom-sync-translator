# 服務埠號
PORT=3100

# 翻譯引擎（正式預設：gemini）
# 可選：gemini | deepl | openai | mymemory
TRANSLATE_PROVIDER=gemini

# Google Gemini（正式會議首選）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepL（選用；僅當 TRANSLATE_PROVIDER=deepl 時為主引擎）
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# OpenAI（選用；僅當 TRANSLATE_PROVIDER=openai 時為主引擎）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TRANSLATE_RETRIES=2
CORS_ORIGIN=*
TRUST_PROXY=0

# 自用會議室路徑密鑰（別人猜不到）；對外只公開 / 與 /try
# 自用網址：/r/<此值>
HOST_LOBBY_TOKEN=ss-73c8b2b0

# 開放他人測試：true = 連公開頁也強制自備 Key（一般不必；/try 已強制）
REQUIRE_CLIENT_API_KEY=false
