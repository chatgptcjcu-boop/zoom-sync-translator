# 服務埠號
PORT=3100

# 翻譯引擎：mymemory | deepl | openai （建議正式會議用 deepl 或 openai）
TRANSLATE_PROVIDER=mymemory

# DeepL（推薦日⇄中會議）
# https://www.deepl.com/pro-api
DEEPL_API_KEY=
# 免費版請設為 https://api-free.deepl.com ；付費版用 https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com

# OpenAI（語境較好，延遲略高）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 翻譯失敗重試次數
TRANSLATE_RETRIES=2

# 允許的 CORS 來源（逗號分隔；* 表示全部，正式環境請改為你的網域）
CORS_ORIGIN=*

# 信任的反向代理層數（部署在 Railway / Render / Nginx 時設 1）
TRUST_PROXY=0

# 正式部署請同步參考：.env.production.example 與 docs/M2-DeepL接線.md
